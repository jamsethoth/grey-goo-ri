{
  "commands": {
    "test": "node scripts/run-suite.ts",
    "lint": "node node_modules/eslint/bin/eslint.js .",
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.json",
    "format": "node node_modules/prettier/bin/prettier.cjs --check ."
  },
  "testPaths": ["**/test/**", "**/tests/**", "**/__tests__/**", "**/*.test.*", "**/*.spec.*", "**/fixtures/**"]
}
