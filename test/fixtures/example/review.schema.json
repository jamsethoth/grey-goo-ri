{
  "type": "object",
  "properties": {
    "claim": { "type": "string", "enum": ["ok", "changes", "blocked"] },
    "reason": { "type": "string", "enum": ["none", "misscoped", "needs-input", "environment"] },
    "summary": { "type": "string" },
    "definitionOfDoneMet": { "type": "boolean" },
    "redGreenEvidenceOk": { "type": "boolean" },
    "needsTest": { "type": "boolean" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": { "type": "string", "enum": ["blocker", "major", "minor"] },
          "file": { "type": "string" },
          "issue": { "type": "string" },
          "fix": { "type": "string" }
        },
        "required": ["severity", "file", "issue", "fix"],
        "additionalProperties": false
      }
    },
    "diagnosis": { "type": "string" }
  },
  "required": ["claim", "reason", "summary", "definitionOfDoneMet", "redGreenEvidenceOk", "needsTest", "findings", "diagnosis"],
  "additionalProperties": false
}
