prefix_rule(pattern = ["node", "scripts/run-suite.ts"], decision = "allow", justification = "The suite needs git, MSYS sh, hard links and TEMP renames, which the Windows sandbox blocks; the launcher accepts only fast with test/contract directory names, check, or coverage (ADR 0016), and drops code-loading environment", match = ["node scripts/run-suite.ts", "node scripts/run-suite.ts fast", "node scripts/run-suite.ts fast git sqlite", "node scripts/run-suite.ts check", "node scripts/run-suite.ts coverage"], not_match = ["npm test", "node --import=x scripts/run-suite.ts", "node scripts/other.mjs", "node scripts/run-suite.mjs"])
