prefix_rule(pattern = ["node", "scripts/run-suite.mjs"], decision = "allow", justification = "The suite needs git, MSYS sh, hard links and TEMP renames, which the Windows sandbox blocks; the launcher accepts only fast with test/contract directory names, or check (ADR 0016), and drops code-loading environment", match = ["node scripts/run-suite.mjs", "node scripts/run-suite.mjs fast", "node scripts/run-suite.mjs fast git sqlite", "node scripts/run-suite.mjs check"], not_match = ["npm test", "node --import=x scripts/run-suite.mjs", "node scripts/other.mjs"])
