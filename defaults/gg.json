{
  "maxParallel": 2,
  "baseBranch": "main",
  "worktreeRoot": "~/worktrees",
  "labelPrefix": "gg",
  "agents": {
    "implementer": {
      "persona": "implementer.md",
      "skills": [], "mcp": [], "plugins": [], "access": "workspace-write", "network": false
    },
    "reviewer": {
      "persona": "reviewer.md",
      "skills": [], "mcp": [], "plugins": [], "access": "read-only", "network": false
    }
  },
  "flows": {
    "default": {
      "plan": null,
      "ticket": {
        "entry": "red",
        "routes": { "misscoped": { "end": "needs-replan" }, "*": { "end": "needs-human" } },
        "vertices": {
          "red": { "use": "implementer", "procedure": "tests-fail", "route": { "ok": "green" } },
          "green": {
            "use": "implementer", "procedure": "implement",
            "inputs": { "tests": { "from": "red.commit.files" }, "red": { "from": "red.red-check.evidence" } },
            "route": { "ok": "reviewer" }
          },
          "reviewer": {
            "use": "reviewer", "procedure": "review",
            "inputs": {
              "report": { "from": ["green.green.response", "implementer-fix.fix.response"] },
              "red": { "from": "red.red-check.evidence" },
              "green": { "from": ["green.test.evidence", "implementer-fix.test.evidence"] }
            },
            "route": { "ok": "publish", "changes": { "to": "implementer-fix", "max": 2, "exhausted": { "end": "needs-human" } } }
          },
          "implementer-fix": {
            "use": "implementer", "procedure": "fix",
            "inputs": {
              "findings": { "from": "reviewer.review.response.findings" },
              "testFiles": { "from": "reviewer.review.response.findings", "pick": "file" },
              "red": { "from": "red.red-check.evidence" }
            },
            "route": { "ok": "reviewer" }
          },
          "publish": {
            "procedure": "publish",
            "inputs": {
              "report": { "from": ["green.green.response", "implementer-fix.fix.response"] },
              "red": { "from": "red.red-check.evidence" },
              "green": { "from": ["green.test.evidence", "implementer-fix.test.evidence"] }
            },
            "route": { "ok": { "end": "ready-for-qa" } }
          }
        }
      }
    }
  }
}
